<?xml version="1.0" encoding="utf-8"?>
<!-- 后台优惠券新增 / 编辑页 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/layout_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/FormLabel"
                android:text="优惠券名称" />

            <EditText
                android:id="@+id/et_name"
                style="@style/FormEditText"
                android:hint="如：满 200 减 30 券"
                android:inputType="text"
                android:maxLength="50" />

            <TextView
                style="@style/FormLabel"
                android:text="优惠券类型" />

            <RadioGroup
                android:id="@+id/rg_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_cash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="满减券"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rb_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="24dp"
                    android:text="折扣券"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <TextView
                style="@style/FormLabel"
                android:text="使用门槛（元，0 表示无门槛）" />

            <EditText
                android:id="@+id/et_threshold"
                style="@style/FormEditText"
                android:hint="0"
                android:inputType="numberDecimal" />

            <LinearLayout
                android:id="@+id/layout_cash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/FormLabel"
                    android:text="满减金额（元）" />

                <EditText
                    android:id="@+id/et_discount_amount"
                    style="@style/FormEditText"
                    android:hint="如 30"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_rate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/FormLabel"
                    android:text="折扣率（0.01 ~ 0.99，0.90 表示 9 折）" />

                <EditText
                    android:id="@+id/et_discount_rate"
                    style="@style/FormEditText"
                    android:hint="如 0.90"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <TextView
                style="@style/FormLabel"
                android:text="发放总量" />

            <EditText
                android:id="@+id/et_total"
                style="@style/FormEditText"
                android:hint="如 1000"
                android:inputType="number" />

            <TextView
                style="@style/FormLabel"
                android:text="每人限领张数" />

            <EditText
                android:id="@+id/et_per_limit"
                style="@style/FormEditText"
                android:hint="1"
                android:inputType="number" />

            <TextView
                style="@style/FormLabel"
                android:text="生效时间（yyyy-MM-dd HH:mm:ss）" />

            <EditText
                android:id="@+id/et_start_time"
                style="@style/FormEditText"
                android:hint="2026-01-01 00:00:00"
                android:inputType="datetime" />

            <TextView
                style="@style/FormLabel"
                android:text="失效时间（yyyy-MM-dd HH:mm:ss）" />

            <EditText
                android:id="@+id/et_end_time"
                style="@style/FormEditText"
                android:hint="2026-12-31 23:59:59"
                android:inputType="datetime" />

            <TextView
                style="@style/FormLabel"
                android:text="状态" />

            <RadioGroup
                android:id="@+id/rg_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_enabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="启用"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rb_disabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="24dp"
                    android:text="停用"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <Button
                android:id="@+id/btn_save"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="28dp"
                android:text="保 存" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
