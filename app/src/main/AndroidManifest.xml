<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- JDBC 直连 MySQL 需要网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".ShopApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShopApp"
        android:usesCleartextTraffic="true">

        <!-- 登录页：应用入口 -->
        <activity
            android:name=".ui.user.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.user.RegisterActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.user.ProfileEditActivity" android:exported="false" />
        <activity android:name=".ui.user.ChangePasswordActivity" android:exported="false" />

        <!-- 商城主界面（首页 / 分类 / 购物车 / 我的） -->
        <activity android:name=".ui.main.MainActivity" android:exported="false" android:launchMode="singleTask" />

        <!-- 商品 -->
        <activity android:name=".ui.product.ProductListActivity" android:exported="false" android:windowSoftInputMode="adjustPan" />
        <activity android:name=".ui.product.ProductDetailActivity" android:exported="false" />

        <!-- 收货地址 -->
        <activity android:name=".ui.address.AddressListActivity" android:exported="false" />
        <activity android:name=".ui.address.AddressEditActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />

        <!-- 优惠券 -->
        <activity android:name=".ui.coupon.CouponCenterActivity" android:exported="false" />
        <activity android:name=".ui.coupon.MyCouponActivity" android:exported="false" />

        <!-- 订单 -->
        <activity android:name=".ui.order.OrderConfirmActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.order.OrderListActivity" android:exported="false" />
        <activity android:name=".ui.order.OrderDetailActivity" android:exported="false" />

        <!-- 后台管理（管理员） -->
        <activity android:name=".ui.admin.AdminMainActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminProductListActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminProductEditActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.admin.AdminCategoryActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminCouponListActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminCouponEditActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.admin.AdminPromotionListActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminPromotionEditActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.admin.AdminOrderListActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminUserListActivity" android:exported="false" />
    </application>

</manifest>
